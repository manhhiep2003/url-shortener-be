# Copy this file to `.env` for local development: `cp .env.example .env`
# Never commit real secrets. `.env` is git-ignored.

# API
PORT=3000
API_PREFIX=api/v1
# Public base URL used to build shortUrl in responses (dev default)
SHORT_BASE_URL=http://localhost:3000

# PostgreSQL
# Local `npm run start:dev` (outside Docker) uses localhost:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public
# Inside docker-compose, `api` service overrides this with:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/url_shortener?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener

# Redis
# Local outside Docker uses localhost, inside compose uses `redis` hostname
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

#JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
